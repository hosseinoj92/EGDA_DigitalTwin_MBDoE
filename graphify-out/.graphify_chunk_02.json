    {"id":"graphify_semantic_cache_prompt_versioning_rationale","label":"Semantic cache is keyed to the extraction prompt file so a prompt upgrade re-extracts instead of replaying stale results (#1939)","file_type":"rationale","source_file":"C:\\Users\\vt4ho\\Simulations\\kinetics_sim\\EDGA\\Homogenous\\.codex\\skills\\graphify\\SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"graphify_shrink_guard_rationale","label":"to_json() refuses to write a smaller graph.json than the existing one, guarding against a bad extraction clobbering good data (#479)","file_type":"rationale","source_file":"C:\\Users\\vt4ho\\Simulations\\kinetics_sim\\EDGA\\Homogenous\\.codex\\skills\\graphify\\SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"graphify_manifest_stamp_gating_rationale","label":"Only semantic files that actually produced output are stamped in the manifest, so a failed chunk is re-queued on the next --update instead of being marked done and lost (#2015)","file_type":"rationale","source_file":"C:\\Users\\vt4ho\\Simulations\\kinetics_sim\\EDGA\\Homogenous\\.codex\\skills\\graphify\\SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"graphify_no_api_key_required_rationale","label":"graphify needs no API key: code is AST-extracted with no LLM, semantic extraction only uses Gemini if a key is already set, otherwise the host agent itself is the LLM","file_type":"rationale","source_file":"C:\\Users\\vt4ho\\Simulations\\kinetics_sim\\EDGA\\Homogenous\\.codex\\skills\\graphify\\SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"graphify_build_merge_direction_preservation_rationale","label":"build_merge() reads graph.json directly without a NetworkX round-trip so edge direction (calls/implements/imports) is always preserved (#801)","file_type":"rationale","source_file":"C:\\Users\\vt4ho\\Simulations\\kinetics_sim\\EDGA\\Homogenous\\.codex\\skills\\graphify\\references\\update.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null}
